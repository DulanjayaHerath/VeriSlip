# Map SHA-256 API-key fingerprints to "free" or "pro". Never store raw keys.
# Generate a random key and fingerprint with Python's `secrets` and `hashlib` modules.
# Shape: {"<64-character-sha256-fingerprint>":"free"}
VERISLIP_API_KEY_HASHES={}

# Optional. When omitted, a process-local store is used for development/testing.
REDIS_URL=redis://localhost:6379/0
